<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HabitTrackerApp.Pages.HomePage"
             Title="Home"
             BackgroundColor="#13131F">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Hero Banner -->
            <Grid HeightRequest="220" BackgroundColor="#7C5CFF">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7C5CFF" Offset="0"/>
                        <GradientStop Color="#4A2FD4" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <VerticalStackLayout VerticalOptions="Center" Padding="28,0" Spacing="8">
                    <Label Text="Good day! 👋" FontSize="16" TextColor="#E0D8FF"/>
                    <Label Text="Track your habits" FontSize="30" FontAttributes="Bold" TextColor="White"/>
                    <Border BackgroundColor="#00D9A3" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20" Padding="12,6" HorizontalOptions="Start">
                        <Label x:Name="WeekCountLabel" Text="0 habits this week"
                               TextColor="#13131F" FontAttributes="Bold" FontSize="13"/>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Cards Grid -->
            <VerticalStackLayout Padding="18,20,18,40" Spacing="14">

                <Label Text="QUICK ACTIONS" FontSize="11" TextColor="#7A7A8E"
                       CharacterSpacing="2" Margin="2,0,0,4"/>

                <!-- Progress Card -->
                <Border BackgroundColor="#252537" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">
                    <Border.Shadow>
                        <Shadow Brush="#7C5CFF" Offset="0,4" Radius="20" Opacity="0.3"/>
                    </Border.Shadow>
                    <Grid Padding="20,18" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Text="📊  Animated Progress" FontSize="17"
                                   FontAttributes="Bold" TextColor="White"/>
                            <Label Text="See your weekly ring animate" FontSize="13"
                                   TextColor="#B4B4C8"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                                BackgroundColor="#7C5CFF" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="→" FontSize="20" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProgressClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Log Habit Card -->
                <Border BackgroundColor="#252537" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">
                    <Grid Padding="20,18" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Text="✏️  Log a Habit" FontSize="17"
                                   FontAttributes="Bold" TextColor="White"/>
                            <Label Text="Add name, duration and date" FontSize="13"
                                   TextColor="#B4B4C8"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                                BackgroundColor="#00D9A3" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="+" FontSize="24" FontAttributes="Bold"
                                   TextColor="#13131F"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- History Card -->
                <Border BackgroundColor="#252537" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">
                    <Grid Padding="20,18" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Text="📋  History" FontSize="17"
                                   FontAttributes="Bold" TextColor="White"/>
                            <Label Text="Browse all saved habits" FontSize="13"
                                   TextColor="#B4B4C8"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                                BackgroundColor="#2F2F44" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="→" FontSize="20" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistoryClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Insights Card -->
                <Border BackgroundColor="#252537" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">
                    <Grid Padding="20,18" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Text="💡  Insights" FontSize="17"
                                   FontAttributes="Bold" TextColor="White"/>
                            <Label Text="Fix your bad habits with tips" FontSize="13"
                                   TextColor="#B4B4C8"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                                BackgroundColor="#FF5C7A" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="💡" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInsightsClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Tutorial Card -->
                <Border BackgroundColor="#252537" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">
                    <Grid Padding="20,18" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Text="▶️  Tutorial Video" FontSize="17"
                                   FontAttributes="Bold" TextColor="White"/>
                            <Label Text="Watch how to use the app" FontSize="13"
                                   TextColor="#B4B4C8"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                                BackgroundColor="#FF5C7A" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="▶" FontSize="18" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTutorialClicked"/>
                    </Border.GestureRecognizers>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
